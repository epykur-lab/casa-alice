{
  "cleanUrls": true,
  "framework": null,
  "rewrites": [
    {
      "source": "/styles.css",
      "destination": "https://cdn.jsdelivr.net/gh/epykur-lab/casa-alice@main/styles.css"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
